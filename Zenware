-- auto buy / collect engine (prompts, touch parts, on-screen buttons)
function X.buyer(keys)
	local B={keys=keys}
	local BAD={"robux","r$","gamepass","premium","vip","donat"}
	local function has(s,list) for _,k in ipairs(list) do if s:find(k,1,true) then return true end end return false end
	B.has=has
	B.PRS=X.getPRS()
	B.named=X.named(keys)
	local function ptxt(pr)
		local p=pr.Parent
		return ((pr.ObjectText or "").." "..(pr.ActionText or "").." "..(p and p.Name or "").." "..((p and p.Parent) and p.Parent.Name or "")):lower()
	end
	local function btxt(d)
		local s=d.Name:lower()
		if d:IsA("TextButton") then s=s.." "..d.Text:lower() end
		for _,ch in ipairs(d:GetChildren()) do if ch:IsA("TextLabel") then s=s.." "..ch.Text:lower() end end
		return s
	end
	local function clickBtn(b)
		if not getconnections then return false end
		local did=false
		for _,sg in ipairs({b.MouseButton1Click,b.Activated,b.MouseButton1Down}) do
			pcall(function()
				for _,c in ipairs(getconnections(sg)) do
					if c.Fire then c:Fire() did=true elseif c.Function then c.Function() did=true end
				end
			end)
		end
		return did
	end
	function B.buttons(list)
		local out={}
		if not getconnections then return out end
		local pgui=LP:FindFirstChildOfClass("PlayerGui")
		if pgui then
			for _,d in ipairs(pgui:GetDescendants()) do
				if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible and not d:IsDescendantOf(gui) then
					local s=btxt(d)
					if has(s,list) and not has(s,BAD) then out[#out+1]=d end
				end
			end
		end
		return out
	end
	function B.run(list,range)
		local n,r=0,root()
		for pr in pairs(B.PRS) do
			if pr.Parent and pr.Enabled then
				local s=ptxt(pr)
				if has(s,list) and not has(s,BAD) then
					local ok2=true
					if range and r then local p=X.opos(pr) ok2=p~=nil and (p-r.Position).Magnitude<=range end
					if ok2 then pcall(fireproximityprompt,pr) n=n+1 end
				end
			end
		end
		local c=0
		for o in pairs(B.named.set) do
			if o.Parent and c<12 then
				local s=o.Name:lower()
				if has(s,list) and not has(s,BAD) then
					local ok2=true
					if range and r then local p=X.opos(o) ok2=p~=nil and (p-r.Position).Magnitude<=range end
					if ok2 then c=c+1 pcall(X.touch,o) end
				end
			end
		end
		for _,b in ipairs(B.buttons(list)) do if clickBtn(b) then n=n+1 end end
		return n+c
	end
	function B.counts(list)
		local a,b2=0,0
		for pr in pairs(B.PRS) do if pr.Parent and has(ptxt(pr),list) then a=a+1 end end
		for o in pairs(B.named.set) do if o.Parent and has(o.Name:lower(),list) then b2=b2+1 end end
		return a,b2
	end
	function B.printAll(list)
		local n=0
		for pr in pairs(B.PRS) do if pr.Parent and has(ptxt(pr),list) then print("[Zenware] prompt:",pr:GetFullName()) n=n+1 end end
		for o in pairs(B.named.set) do if o.Parent then print("[Zenware] part:",o:GetFullName()) n=n+1 end end
		for _,b in ipairs(B.buttons(list)) do print("[Zenware] button:",b:GetFullName()) n=n+1 end
		return n
	end
	return B
end
