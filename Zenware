-- ===== THEME ENGINE =====
function Th.walk()
	local l={}
	for _,r in ipairs({main,lbx,ts,fl}) do l[#l+1]=r for _,d in ipairs(r:GetDescendants()) do l[#l+1]=d end end
	return l
end
Th.BGK,Th.TXK={"BG","RW","RB","AC","OF","TR"},{"TX","DIM","OA","AC"}
function Th.rm(o,old)
	if o:GetAttribute("keep") then return end
	if o:IsA("GuiObject") then local v=o.BackgroundColor3 for _,k in ipairs(Th.BGK) do if v==old[k] then o.BackgroundColor3=T[k] break end end end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		local v=o.TextColor3 for _,k in ipairs(Th.TXK) do if v==old[k] then o.TextColor3=T[k] break end end
	elseif o:IsA("UIStroke") then
		if o.Color==old.TX then o.Color=T.TX elseif o.Color==old.AC then o.Color=T.AC end
	end
end
function Th.save() if Th.sv then return end Th.sv=true task.delay(.5,function() Th.sv=false pcall(writefile,"ZenMenu_Style.json",HS:JSONEncode(ST)) end) end
function Th.apply(name)
	ST.theme=name
	local old={} for k,v in pairs(T) do old[k]=v end
	Th.use(name)
	for _,o in ipairs(Th.walk()) do pcall(Th.rm,o,old) end
	Th.rainbow=(name=="Rainbow")
	stg.Color=Th.rainbow and Th.RBSEQ or Th.glow()
	X.navPaint()
	for _,f in ipairs(REP) do pcall(f) end
	if not Th.rainbow then for _,o in ipairs(Th.walk()) do local gg=o:FindFirstChild("ZRB") if gg then gg:Destroy() end end Th.rbl=nil end
	Th.save()
end
function Th.setpack(n)
	ST.pack=n
	local oH,oB=T.HF,T.BF
	Th.usepack(n)
	for _,o in ipairs(Th.walk()) do
		if (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) and not o:GetAttribute("keep") and not o:GetAttribute("fk") then
			local f=o.Font if f==oH then o.Font=T.HF elseif f==oB then o.Font=T.BF end
		end
	end
	for _,s in ipairs(X.secs) do pcall(X.secLayout,s) end
	Th.save()
end
function Th.corner(n)
	ST.corner=n
	for _,o in ipairs(Th.walk()) do if o:IsA("UICorner") then local r=o:GetAttribute("R") if r then o.CornerRadius=UDim.new(0,Th.cr(r)) end end end
	Th.save()
end
Th.rbA,Th.rbS=0,0
function Th.rb(dt)
	if not Th.rainbow then return end
	local rot=(os.clock()*90)%360
	stg.Rotation=rot
	Th.rbA=Th.rbA+dt if Th.rbA<.08 then return end Th.rbA=0
	if not Th.rbl or tick()-Th.rbS>1.5 then
		Th.rbS=tick() Th.rbl={}
		for _,o in ipairs(Th.walk()) do
			if o:IsA("GuiObject") and not o:GetAttribute("keep") and ((o.BackgroundTransparency<.99 and o.BackgroundColor3==T.AC) or o.Name=="ZTitle") then
				local gg=o:FindFirstChild("ZRB")
				if not gg then gg=Instance.new("UIGradient") gg.Name="ZRB" gg.Color=Th.RBSEQ gg.Parent=o end
				Th.rbl[#Th.rbl+1]=gg
			end
		end
	end
	for _,gg in ipairs(Th.rbl) do if gg.Parent then gg.Rotation=rot end end
end
