		vl.Text=string.format(fmt,v)
		if fn then fn(v) end
	end
	SL[k]=s s(F[k])
	local act,off,sf=nil,0,nil
	local function setX(x) s(mn+math.clamp((x-tkk.AbsolutePosition.X)/math.max(tkk.AbsoluteSize.X,1),0,1)*(mx-mn)) end
	local function stop()
