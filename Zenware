			X.RT[n]=tick() r=nil
			for _,rt in ipairs({LP,game:GetService("ReplicatedStorage")}) do
				local x=rt:FindFirstChild(n,true)
				if x and (x:IsA("RemoteEvent") or x:IsA("RemoteFunction")) then r=x break end
			end
			X.RM[n]=r
			if r then return r end
		end
	end
end
