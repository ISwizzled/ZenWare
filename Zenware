	local fmt="%."..dec.."f"
	local function s(v)
		v=math.clamp(v,mn,mx)
		v=mn+math.floor((v-mn)/stp+.5)*stp
		v=math.clamp(tonumber(string.format(fmt,v)) or mn,mn,mx)
